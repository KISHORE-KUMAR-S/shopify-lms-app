# ---------------------------------------------------------------------------
# Shopify app credentials
# `shopify app dev` injects SHOPIFY_API_KEY / SHOPIFY_API_SECRET / SHOPIFY_APP_URL
# automatically. Set them explicitly only when running outside the CLI
# (e.g. the standalone Express service, or `npm run start`).
# ---------------------------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=write_products,write_metaobjects,write_metaobject_definitions

# ---------------------------------------------------------------------------
# PostgreSQL
# Shared by the embedded app (Shopify session storage) and the Express API.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lms_app?schema=public

# ---------------------------------------------------------------------------
# Standalone Express REST API (server/)
# ---------------------------------------------------------------------------
API_PORT=3001
# Origin the embedded app is served from, used for the API's CORS allowlist.
# Comma-separate multiple origins. During `shopify app dev` this is the
# tunnel URL that SHOPIFY_APP_URL points at.
API_CORS_ORIGINS=https://admin.shopify.com

# Base URL the embedded React frontend uses to reach the Express API.
VITE_API_BASE_URL=http://localhost:3001
